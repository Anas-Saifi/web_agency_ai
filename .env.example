# LLM & Model APIs
HIVE_API_KEY=your_hive_or_deepseek_api_key
GOOGLE_API_KEY=your_google_api_key
GROQ_API_KEY=your_groq_api_key
OPENROUTER_API_KEY=your_openrouter_api_key
TAVILY_API_KEY=your_tavily_search_api_key

# PostgreSQL Database (used by postgres-mcp)
DATABASE_URI=postgresql://agency_user:agency_pass@postgres:5432/web_agency_db

# HubSpot MCP OAuth Credentials
HUBSPOT_CLIENT_ID=your_hubspot_client_id
HUBSPOT_CLIENT_SECRET=your_hubspot_client_secret

# Google Calendar MCP Credentials
GOOGLE_OAUTH_CREDENTIALS=/app/gcp-oauth.keys.json

# LangSmith Tracing (Optional)
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=web_agency_ai
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key

# Server settings
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=*
DEBUG=false
